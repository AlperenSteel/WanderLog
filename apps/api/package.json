{
  "name": "@wanderprint/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --dts --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wanderprint/shared": "workspace:*",
    "@prisma/client": "^5.20.0",
    "express": "^4.19.2",
    "argon2": "^0.40.3",
    "bullmq": "^5.13.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "express-rate-limit": "^7.4.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.4",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.20.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^11.2.2"
  }
}
