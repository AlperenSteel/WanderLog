# ─────────────────────── DATABASE ───────────────────────
DATABASE_URL="postgresql://wanderprint:wanderprint_dev@localhost:5432/wanderprint_dev?schema=public"

# ─────────────────────── REDIS ───────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────── AUTH ───────────────────────
# openssl rand -hex 32
JWT_ACCESS_SECRET="replace_with_32_byte_random_hex"
JWT_REFRESH_SECRET="replace_with_another_32_byte_random_hex"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─────────────────────── APP ───────────────────────
NODE_ENV="development"
PORT=3000
API_URL="http://localhost:3000"

# ─────────────────────── CORS ───────────────────────
CORS_ORIGINS="http://localhost:8081,exp://localhost:8081"

# ─────────────────────── MAIL ───────────────────────
MAIL_PROVIDER="console"   # console | resend | ses
RESEND_API_KEY=""
MAIL_FROM="noreply@wanderprint.app"

# ─────────────────────── STORAGE ───────────────────────
STORAGE_PROVIDER="local"  # local | s3
STORAGE_LOCAL_PATH="./uploads"

# S3 (doldur, gerektiğinde)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ─────────────────────── RATE LIMIT ───────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 dakika
RATE_LIMIT_MAX=100

# ─────────────────────── LOGGING ───────────────────────
LOG_LEVEL="info"  # trace | debug | info | warn | error
